# Copy to .env.<name> and fill it in. Git ignores every .env.* except this example.
# The launchpad checks that each is set and never reads or prints a value.
HCLOUD_TOKEN=                 # Hetzner Cloud, read and write, from the project's Security page
PULUMI_CONFIG_PASSPHRASE=     # encrypts the local Pulumi state under .pulumi/
TAILSCALE_AUTH_KEY=           # created for tag:server, reusable, not ephemeral
